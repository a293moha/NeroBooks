# Copy to .env for local development. Never commit a real .env file.

# From Auth0: Applications -> NeroBooks (Single Page Application) -> Settings.
# Neither of these is a secret -- a SPA client id is public by design (it
# ships in this bundle) -- but they still belong in an env var, not
# hardcoded, so different environments (dev/staging/prod Auth0 tenants)
# don't require a code change.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id

# From Auth0: Applications -> APIs -> [your API] -> Identifier. Must match
# AUTH0_AUDIENCE in server/.env.example exactly -- this is what scopes the
# access token this app requests to the NeroBooks backend.
VITE_AUTH0_AUDIENCE=https://api.nerobooks.app

# Where the backend (server/) is reachable. Local dev only for now -- no
# production deployment exists yet (see docs/backend-roadmap.md).
VITE_API_BASE_URL=http://localhost:4000
