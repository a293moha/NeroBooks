# Copy to .env for local development. Never commit a real .env file.

# The backend connects as the restricted `nerobooks_app` role (see
# db/migrations/0015_app_role_and_grants.up.sql), never as a superuser —
# row-level security (0017) only takes effect for non-superuser connections.
DATABASE_URL=postgres://nerobooks_app:dev_only_password_change_me@localhost:5432/nerobooks_dev

# A completely separate, more privileged (BYPASSRLS) role, used ONLY by
# server/src/db/platformPool.ts and only ever imported from
# routes/platform.routes.ts (see db/migrations/0018_platform_admin_role).
# Guard this credential's access tightly in any real deployment — anyone
# who can supply this connection string can read/write every company's
# data with no row-level-security restriction at all.
PLATFORM_DATABASE_URL=postgres://nerobooks_platform_admin:dev_only_password_change_me@localhost:5432/nerobooks_dev

# From your Auth0 tenant: Applications -> [your API] -> Settings -> Domain,
# and Applications -> APIs -> [your API] -> Identifier, respectively.
# Neither is a secret -- both are public by design (the domain and audience
# ship in the frontend bundle too) -- but they still belong in env vars, not
# hardcoded, so per-environment values (dev/staging/prod tenants) don't
# require a code change.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.nerobooks.app

# A *different* Auth0 application: a Machine-to-Machine app authorized for
# Auth0's own Management API (scopes: create:users, create:user_tickets,
# read:users). Used only by routes/platform.routes.ts, to let a platform
# admin register a new customer by email and send them a link to set
# their own password. Unlike the SPA's client id above, the secret here
# is real and must never be committed or shipped to the frontend.
AUTH0_MANAGEMENT_CLIENT_ID=your-m2m-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-m2m-client-secret

# Where a newly-registered customer lands after setting their password.
PRIMARY_FRONTEND_URL=http://localhost:5173

PORT=4000
NODE_ENV=development

# Comma-separated. The SPA is served from more than one origin at once (a
# custom domain and GitHub Pages) plus localhost for dev.
CORS_ORIGINS=http://localhost:5173,https://www.nerobook.com,https://a293moha.github.io

# Where uploaded company files are stored, company-scoped under this root.
# In production, swap the storage adapter for S3/GCS with the same
# per-company scoping principle — see server/src/storage/localAdapter.ts.
STORAGE_ROOT=./storage-data
